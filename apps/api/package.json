{
  "name": "@openbarrio/api",
  "version": "0.2.0",
  "description": "Universal REST API server for OpenBarrio (Cloudflare Workers & Node.js)",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:worker": "wrangler dev src/worker.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "deploy": "wrangler deploy src/worker.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "@hono/swagger-ui": "^0.4.1",
    "@hono/typebox-validator": "^0.5.1",
    "@openbarrio/core": "workspace:*",
    "@sinclair/typebox": "^0.34.4",
    "hono": "^4.6.8"
  },
  "devDependencies": {
    "@types/node": "^22.8.4",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.3",
    "wrangler": "^3.84.0"
  }
}
