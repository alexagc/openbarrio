{
  "name": "@openbarrio/api",
  "version": "1.3.1",
  "description": "Universal REST API server for OpenBarrio (Cloudflare Workers & Node.js)",
  "author": "Alejandro Gómez Canal",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/alexcg1/openbarrio.git",
    "directory": "apps/api"
  },
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:worker": "wrangler dev src/worker.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "deploy": "wrangler deploy src/worker.ts",
    "d1:create": "wrangler d1 create openbarrio-d1",
    "d1:migrate:local": "wrangler d1 execute openbarrio-d1 --file=./migrations/0001_initial_schema.sql --local",
    "d1:migrate:remote": "wrangler d1 execute openbarrio-d1 --file=./migrations/0001_initial_schema.sql --remote",
    "r2:create": "wrangler r2 bucket create openbarrio-r2",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.8",
    "@hono/swagger-ui": "^0.6.2",
    "@openbarrio/core": "workspace:*",
    "@sinclair/typebox": "^0.34.52",
    "hono": "^4.13.18"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "wrangler": "^4.162.0"
  }
}
