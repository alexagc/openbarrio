{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "openbarrio-api",
  "main": "src/worker.ts",
  "compatibility_date": "2024-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "openbarrio-d1",
      // Replace with your actual database_id from `wrangler d1 create openbarrio-d1`
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "TILES_BUCKET",
      "bucket_name": "openbarrio-r2"
    }
  ]
}
