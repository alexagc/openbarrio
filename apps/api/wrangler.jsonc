{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "openbarrio-api",
  "main": "src/worker.ts",
  "compatibility_date": "2024-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "openbarrio-d1",
      "database_id": "978c6710-c30f-4a1c-9afd-93c850a2b202",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "TILES_BUCKET",
      "bucket_name": "openbarrio-r2"
    }
  ]
}
