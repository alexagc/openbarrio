{
  "name": "@openbarrio/extension",
  "version": "1.3.1",
  "description": "Chrome Manifest V3 Companion Extension for OpenBarrio (Idealista & Fotocasa)",
  "author": "Alejandro Gómez Canal",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/alexcg1/openbarrio.git",
    "directory": "apps/extension"
  },
  "type": "module",
  "private": true,
  "scripts": {
    "build": "tsc && node build.js",
    "package": "tsc && node build.js && node ../../scripts/package-extension.mjs",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run"
  },
  "dependencies": {
    "@openbarrio/core": "workspace:*"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.7",
    "@types/jsdom": "^30.0.0",
    "jsdom": "^31.0.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
