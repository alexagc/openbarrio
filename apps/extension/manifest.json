{
  "manifest_version": 3,
  "name": "OpenBarrio - Detector Inmobiliario Oficial",
  "version": "0.1.0",
  "description": "Auditoría pública en tiempo real de Catastro e INE para Idealista y Fotocasa",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "*://*.idealista.com/*",
    "*://*.fotocasa.es/*",
    "http://localhost:3001/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*.idealista.com/inmueble/*",
        "*://*.fotocasa.es/*/comprar/*",
        "*://*.fotocasa.es/*/alquiler/*"
      ],
      "js": ["dist/content.js"],
      "run_at": "document_idle"
    }
  ]
}
