{
  "manifest_version": 3,
  "name": "OpenBarrio - Due Diligence Inmobiliario Oficial",
  "version": "0.6.2",
  "description": "Companion widget oficial para Idealista y Fotocasa. Auditoría instantánea de Catastro, INE, MITECO y MIVAU.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "*://*.idealista.com/*",
    "*://*.fotocasa.es/*",
    "http://localhost:3001/*",
    "https://*.workers.dev/*",
    "https://api.openbarrio.org/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup/index.html",
    "default_title": "OpenBarrio - Auditoría Inmobiliaria",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.idealista.com/inmueble/*",
        "*://*.fotocasa.es/*/comprar/*",
        "*://*.fotocasa.es/*/alquiler/*",
        "*://*.fotocasa.es/es/comprar/*",
        "*://*.fotocasa.es/es/alquiler/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
