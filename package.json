{
  "name": "openbarrio-monorepo",
  "version": "1.3.1",
  "private": true,
  "type": "module",
  "description": "Civic-tech and real estate due diligence platform using Spanish public open data",
  "author": "Alejandro Gómez Canal",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/alexcg1/openbarrio.git"
  },
  "scripts": {
    "dev": "pnpm --parallel run dev",
    "build": "pnpm --recursive run build",
    "test": "pnpm --recursive run test",
    "package:extension": "pnpm --filter @openbarrio/extension run build && node scripts/package-extension.mjs",
    "lint": "eslint . --max-warnings=0",
    "lint:workspaces": "pnpm --recursive run lint"
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "eslint": "^9.14.0",
    "globals": "^15.12.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.13.0",
    "vitest": "^3.2.6",
    "wrangler": "^3.114.17"
  },
  "pnpm": {
    "overrides": {
      "maplibre-gl": ">=6.4.1",
      "hono": ">=4.13.16",
      "tinypool": ">=2.1.1",
      "undici": ">=6.21.1",
      "minimatch": ">=9.0.5",
      "ws": ">=8.21.0",
      "sharp": ">=0.35.0",
      "vite": ">=5.4.14 <6.0.0",
      "@fastify/busboy": ">=3.0.0"
    }
  },
  "packageManager": "pnpm@9.12.2"
}
