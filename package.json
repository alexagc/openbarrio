{
  "name": "openbarrio-monorepo",
  "version": "1.3.1",
  "private": true,
  "type": "module",
  "description": "Civic-tech and real estate due diligence platform using Spanish public open data",
  "author": "Alejandro Gómez Canal",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/alexcg1/openbarrio.git"
  },
  "scripts": {
    "dev": "pnpm --parallel run dev",
    "build": "pnpm --recursive run build",
    "test": "pnpm --recursive run test",
    "package:extension": "pnpm --filter @openbarrio/extension run build && node scripts/package-extension.mjs",
    "lint": "eslint . --max-warnings=0",
    "lint:workspaces": "pnpm --recursive run lint"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0",
    "wrangler": "^4.162.0"
  },
  "packageManager": "pnpm@9.12.2"
}
