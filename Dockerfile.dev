FROM node:22-bookworm

WORKDIR /workspace

# Install pnpm and SQLite
RUN apt-get update && apt-get install -y sqlite3 libsqlite3-dev && rm -rf /var/lib/apt/lists/*
RUN corepack enable && corepack prepare pnpm@9.12.2 --activate

# Copy workspace definitions
COPY package.json pnpm-lock.yaml* pnpm-workspace.yaml tsconfig.base.json ./
COPY packages/core/package.json ./packages/core/
COPY packages/etl/package.json ./packages/etl/
COPY apps/api/package.json ./apps/api/
COPY apps/web/package.json ./apps/web/
COPY apps/extension/package.json ./apps/extension/

# Install dependencies inside Linux container
RUN pnpm install --no-frozen-lockfile

# Copy full source tree
COPY . .

# Build core schemas and packages
RUN pnpm --filter @openbarrio/core run build

EXPOSE 3001 5173

CMD ["sh", "-c", "node scripts/init-local-db.mjs && pnpm --parallel run dev"]
