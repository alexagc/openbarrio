{
  "name": "@openbarrio/core",
  "version": "0.7.1",
  "description": "Shared domain models, schemas, and scoring formulas for OpenBarrio",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./tokens": {
      "types": "./dist/tokens/index.d.ts",
      "import": "./dist/tokens/index.js",
      "default": "./dist/tokens/index.js"
    },
    "./tokens.css": "./tokens.css"
  },
  "scripts": {
    "build": "tsc",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run"
  },
  "dependencies": {
    "@sinclair/typebox": "^0.34.4"
  },
  "devDependencies": {
    "eslint": "^9.14.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.3"
  }
}
